#include <MKL25Z4.h>

#define ADC_CANAL   8u    /* PTB0 = ADC0_SE8 */

#define SW1  0x04u    /* PTE2 */
#define SW2  0x08u    /* PTE3 */

#define CLK_HZ 20970000

void UART0_init(void);
void UART0_putc(char c);
char UART0_getc(void);
int  UART0_kbhit(void);
void UART0_puts(const char *str);
void UART0_putn(unsigned int n);

void timers_init(void);
void delayMs(int n);
void delayUs(int n);

void LED_init(void);
void LED_set(int value);
int  seleccion(int numero);

void keypad_init(void);
char keypad_getkey(void);
char esperar_tecla(void);

void ADC_init(void);
unsigned int ADC_read(unsigned char canal);

void buttons_init(void);
unsigned int buttons_read(void);

void showMenu(void);
void processCommand(char option);
void optionLED(void);
void optionADC(void);
void optionKeypad(void);
void optionButtons(void);

static const char keymap[16] = {
    '1', '2', '3', 'A',
    '4', '5', '6', 'B',
    '7', '8', '9', 'C',
    '*', '0', '#', 'D'
};



void UART0_init(void){
    SIM->SCGC4 |= 0x0400;
    SIM->SOPT2 = (SIM->SOPT2 & ~0x0C000000u) | 0x04000000u;

    UART0->C2 = 0x00;

    UART0->C4  = 0x0F;
    UART0->BDH = 0x00;
    UART0->BDL = 0x0B;

    UART0->C1 = 0x00;
    UART0->C2 = 0x0C;

    SIM->SCGC5   |= 0x0200;
    PORTA->PCR[2] = 0x0200; //TX
    PORTA->PCR[1] = 0x0200; //RX
}

void UART0_putc(char c)
{
    while (!(UART0->S1 & 0x80)) { }
    UART0->D = (uint8_t)c;
}

char UART0_getc(void)
{
    while (!(UART0->S1 & 0x20)) { }   
    return (char)UART0->D;
}

int UART0_kbhit(void)
{
    return (UART0->S1 & 0x20) != 0;
}

void UART0_puts(const char *str)
{
    while (*str != '\0') {
        if (*str == '\n') {
            UART0_putc('\r');
        }
        UART0_putc(*str);
        str++;
    }
}

void UART0_putn(unsigned int n)
{
    char buf[11];
    int i = 0;

    if (n == 0) {
        UART0_putc('0');
        return;
    }
    while (n > 0) {
        buf[i++] = (char)('0' + (n % 10));
        n /= 10;
    }
    while (i > 0) {
        UART0_putc(buf[--i]);
    }
}


void timers_init(void)
{
    SIM->SCGC6 |= 0x01000000;
    SIM->SOPT2 = (SIM->SOPT2 & ~0x03000000u) | 0x01000000u;
    TPM0->SC  = 0;
    TPM0->CNT = 0;
    TPM0->MOD = (CLK_HZ / 1000000u) - 1u;
    TPM0->SC  = 0x80;
    TPM0->SC  = 0x08;
}

void delayMs(int n)
{
    int i;
    SysTick->LOAD = (CLK_HZ / 1000u) - 1u;
    SysTick->CTRL = 0x5;
    for (i = 0; i < n; i++) {
        while ((SysTick->CTRL & 0x10000) == 0) { }
    }
    SysTick->CTRL = 0;
}

void delayUs(int n)
{
    int i;
    for (i = 0; i < n; i++) {
        while ((TPM0->SC & 0x80) == 0) { }
        TPM0->SC |= 0x80;
    }
}


void LED_init(void)
{
    SIM->SCGC5 |= 0x400;
    SIM->SCGC5 |= 0x1000;

    PORTB->PCR[18] = 0x100;
    PTB->PDDR |= 0x40000;
    PTB->PSOR  = 0x40000;

    PORTB->PCR[19] = 0x100;
    PTB->PDDR |= 0x80000;
    PTB->PSOR  = 0x80000;

    PORTD->PCR[1] = 0x100;
    PTD->PDDR |= 0x02;
    PTD->PSOR  = 0x02;
}

void LED_set(int value)
{
    if (value & 1) PTB->PCOR = 0x40000; else PTB->PSOR = 0x40000;
    if (value & 2) PTB->PCOR = 0x80000; else PTB->PSOR = 0x80000;
    if (value & 4) PTD->PCOR = 0x02;    else PTD->PSOR = 0x02;
}

int seleccion(int numero)
{
    static const int colores[8] = {
        1, /* 1: Rojo     */
        2, /* 2: Verde    */
        3, /* 3: Amarillo */
        4, /* 4: Azul     */
        7, /* 5: Blanco   */
        5, /* 6: Magenta  */
        6, /* 7: Cian     */
        0  /* 8: Apagado  */
    };

    if (numero >= 1 && numero <= 8) {
        int color_elegido = colores[numero - 1];
        LED_set(color_elegido);
        return color_elegido;
    }

    return -1;   /* indice fuera de rango */
}

void keypad_init(void)
{
    int i;
    SIM->SCGC5 |= 0x0800;
    for (i = 0; i < 8; i++) {
        PORTC->PCR[i] = 0x103;
    }
    PTC->PDDR = 0x0F;
}

char keypad_getkey(void)
{
    int row, col;
    static const char row_select[4] = {0x01, 0x02, 0x04, 0x08};

    PTC->PDDR |= 0x0F;
    PTC->PCOR  = 0x0F;
    delayUs(50);
    col = PTC->PDIR & 0xF0;
    PTC->PDDR = 0;
    if (col == 0xF0) return 0;

    for (row = 0; row < 4; row++) {
        PTC->PDDR = row_select[row];
        PTC->PCOR = row_select[row];
        delayUs(50);
        col = PTC->PDIR & 0xF0;
        if (col != 0xF0) break;
    }
    PTC->PDDR = 0;

    if (row == 4)     return 0;
    if (col == 0xE0)  return (char)(row * 4 + 1);
    if (col == 0xD0)  return (char)(row * 4 + 2);
    if (col == 0xB0)  return (char)(row * 4 + 3);
    if (col == 0x70)  return (char)(row * 4 + 4);
    return 0;
}

char esperar_tecla(void)
{
    char key = 0;

    while (key == 0) {
        key = keypad_getkey();
    }

    char tecla_presionada = keymap[key - 1];

    while (keypad_getkey() != 0) {        /* esperar a que se suelte */
        delayMs(10);
    }

    return tecla_presionada;
}

void ADC_init(void)
{
    SIM->SCGC6 |= 0x08000000;
    SIM->SCGC5 |= 0x400;

    PORTB->PCR[0] = 0x000;

    ADC0->CFG1 = 0x24;
    ADC0->CFG2 = 0x00;
    ADC0->SC2  = 0x00;
    ADC0->SC3  = 0x00;
}

unsigned int ADC_read(unsigned char canal)
{
    ADC0->SC1[0] = canal & 0x1F;
    while ((ADC0->SC1[0] & 0x80) == 0) { }
    return (unsigned int)ADC0->R[0];
}


void buttons_init(void)
{
    SIM->SCGC5 |= 0x2000;
    PORTE->PCR[2] = 0x103;
    PORTE->PCR[3] = 0x103;
    PTE->PDDR &= ~(SW1 | SW2);
}

unsigned int buttons_read(void)
{
    uint32_t entrada = PTE->PDIR;
    unsigned int estado = 0;

    if ((entrada & SW1) == 0) estado |= 0x01;
    if ((entrada & SW2) == 0) estado |= 0x02;
    return estado;
}

void showMenu(void)
{
    UART0_puts("\n");
    UART0_puts("========================================\n");
    UART0_puts("            KL25Z UART SYSTEM\n");
    UART0_puts("========================================\n");
    UART0_puts("  L) LED RGB\n");
    UART0_puts("  A) Lectura de ADC\n");
    UART0_puts("  K) Teclado\n");
    UART0_puts("  B) Botones\n");
    UART0_puts("----------------------------------------\n");
    UART0_puts("Opcion> ");
}


void optionLED(void)
{
    char c;

    UART0_puts("\n--- LED RGB ---\n");
    UART0_puts("  1 Rojo    2 Verde   3 Amarillo  4 Azul\n");
    UART0_puts("  5 Blanco  6 Magenta 7 Cian      8 Apagado\n");
    UART0_puts("  Q para volver\n");

    while (1) {
        UART0_puts("LED> ");
        c = UART0_getc();
        UART0_putc(c);
        UART0_puts("\n");

        if (c == 'q' || c == 'Q') {
            break;
        }
        else if (c >= '1' && c <= '8') {
            seleccion(c - '0');
            UART0_puts("Color aplicado\n");
        }
        else {
            UART0_puts("Opcion no valida\n");
        }
    }
}


// ADC = PTB0
void optionADC(void)
{
    unsigned int valor, mv;

    UART0_puts("\n--- ADC ---\n");
    UART0_puts("Pulsa cualquier tecla del terminal paar salir.\n");
    while (!UART0_kbhit()) {
        valor = ADC_read(ADC_CANAL);
        mv    = (valor * 3300u) / 4095u;

        UART0_puts("Cuentas: ");
        UART0_putn(valor);
        UART0_puts("   Voltaje: ");
        UART0_putn(mv / 1000u);
        UART0_putc('.');
        UART0_putn((mv / 100u) % 10u);
        UART0_putn((mv / 10u) % 10u);
        UART0_putn(mv % 10u);
        UART0_puts(" V\n");

        delayMs(500);
    }
    (void)UART0_getc();
}


void optionKeypad(void)
{
    char key;

    UART0_puts("\n--- Teclado matricial ---\n");
    UART0_puts("Q en el terminal para salir.\n");

    while (1) {
        if (UART0_kbhit()) {
            char c = UART0_getc();
            if (c == 'q' || c == 'Q') break;
        }

        key = keypad_getkey();
        if (key != 0) {
            char tecla = keymap[key - 1];

            UART0_puts("Tecla: ");
            UART0_putc(tecla);
            UART0_puts("   (codigo ");
            UART0_putn((unsigned int)key);
            UART0_puts(")\n");

            while (keypad_getkey() != 0){ 
                delayMs(10);
            }
        }
    }
}


void optionButtons(void)
{
    unsigned int estado, anterior = 0xFF;

    UART0_puts("\n--- Botones ---\n");
    UART0_puts("manda un caracter para salir\n");

    while (!UART0_kbhit()) {
        estado = buttons_read();

        if (estado != anterior) {
            UART0_puts("Boton1: ");
            UART0_puts((estado & 0x01) ? "pulsado" : "libre  ");
            UART0_puts("Boton2: ");
            UART0_puts((estado & 0x02) ? "pulsado" : "libre  ");
            UART0_puts("\n");

            LED_set((int)estado);
            anterior = estado;
        }
        delayMs(20);
    }
    (void)UART0_getc();
    LED_set(0);
}


/* ---------- Despachador ---------- */
void processCommand(char option)
{
    switch (option) {
        case 'L': optionLED();     break;
        case 'A': optionADC();     break;
        case 'K': optionKeypad();  break;
        case 'B': optionButtons(); break;
        case '\r':
        case '\n':
            return;

        default:
            UART0_puts("\nOpcion no valida.\n");
            break;
    }

    showMenu();
}


/* =====================================================================
 * MAIN
 * ===================================================================== */

int main(void)
{
    char option;

    /* Inicializacion de perifericos */
    timers_init();
    UART0_init();
    LED_init();
    LED_set(0);
    keypad_init();
    ADC_init();
    buttons_init();
    showMenu();

    while (1) {
        option = UART0_getc();
        UART0_putc(option);        /* eco de la opcion elegida */
        UART0_puts("\n");
        processCommand(option);
    }
}
